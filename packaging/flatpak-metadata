[Application]
name=io.github.orbitexplorer.Orbit
runtime=org.freedesktop.Platform/x86_64/25.08
sdk=org.freedesktop.Sdk/x86_64/25.08
command=Orbit

[Context]
shared=ipc;network;
sockets=wayland;fallback-x11;pulseaudio;
devices=dri;
filesystems=host;host-os;host-etc;/run/media;/mnt;

[Session Bus Policy]
org.freedesktop.Flatpak=talk
org.freedesktop.FileManager1=talk

[Environment]
ORBIT_FLATPAK=1
